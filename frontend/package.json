{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "pre:generate-client": "curl -o openapi.json $VITE_API_URL/openapi.json",
    "generate-client": "bunx openapi-typescript-codegen --input openapi.json --output src/api --client fetch",
    "preview": "vite preview",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.0",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.564.0",
    "openapi-typescript-codegen": "^0.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cypress": "^15.10.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
