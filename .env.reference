# ──────────────────────────────────────────────────────────────────────────────
# Interlock API – Environment Variables Reference
#
# Copy this file to `.env` for local development.
# Copy this file to `.env.prod` for production secrets (used by deploy.sh).
#
# Do NOT commit .env or .env.prod to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI / Agent ───────────────────────────────────────────────────────────────
# Required for the /agent/ask endpoint (Google Gemini).
GEMINI_API_KEY=your-gemini-api-key-here

# ── SQLite Database ─────────────────────────────────────────────────────────
# Path to the primary (read-write) SQLite database file.
# For local development, use a relative or absolute path.
# In production, point to a GCS FUSE / NFS mounted path.
# The parent directory will be created automatically if it doesn't exist.
# Default: ./data/interlock.db
DB_PATH=./data/interlock.db

# (Optional) Path to a read-only SQLite database.
# Leave commented out if not using a secondary read-only store.
# DB_READ_ONLY_PATH=./data/interlock_readonly.db