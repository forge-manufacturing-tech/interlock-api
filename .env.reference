# ──────────────────────────────────────────────────────────────────────────────
# Interlock API – Environment Variables Reference
#
# Copy this file to `.env` for local development.
# Copy this file to `.env.prod` for production secrets (used by deploy.sh).
#
# Do NOT commit .env or .env.prod to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI / Agent ───────────────────────────────────────────────────────────────
# Required for the /agent/ask endpoint (Google Gemini).
# The agent uses the latest Gemini models for reasoning (e.g. gemini-2.0-flash-thinking-exp-01-21).
GEMINI_API_KEY=your-gemini-api-key-here

# ── PostgreSQL Database ─────────────────────────────────────────────────────
# Connection string for the PostgreSQL database.
# For local development with docker-compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interlock
