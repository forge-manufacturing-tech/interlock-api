# ──────────────────────────────────────────────────────────────────────────────
# Interlock API – Environment Variables Reference
#
# Copy this file to `.env` for local development.
# Copy this file to `.env.prod` for production secrets (used by deploy.sh).
#
# Do NOT commit .env or .env.prod to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI / Agent ───────────────────────────────────────────────────────────────
# Required for the /agent/ask endpoint (Google Gemini).
GEMINI_API_KEY=your-gemini-api-key-here

# ── Kùzu Graph Database ─────────────────────────────────────────────────────
# Path to the primary (private) Kùzu database.
# For local development, use a relative or absolute path to a local directory.
# The directory will be created automatically if it doesn't exist.
# Default: ./interlock.kuzu
KUZU_DB_PATH=./data/interlock.kuzu

# (Optional) Path to a read-only public Kùzu database.
# Leave commented out if not using a public graph.
# KUZU_PUBLIC_DB_PATH=./data/interlock_public.kuzu

# (Optional) Buffer pool size in bytes for the Kùzu database engine.
# Default: 1073741824 (1 GB)
# KUZU_BUFFER_POOL_SIZE=1073741824