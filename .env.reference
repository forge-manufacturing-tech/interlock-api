OPENROUTER_API_KEY=your-api-key-here
# For CockroachDB, use cockroachdb:// instead of postgresql:// to avoid version parsing issues
DATABASE_URL=cockroachdb://user:password@host:26257/defaultdb?sslmode=require
JWT_SECRET='test-jwt'

# Blob Storage
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=your-bucket-name
