modules = ["python-3.12", "bash", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["graphviz"]

[userenv]

[userenv.shared]
DB_PATH = "./data/interlock.db"
JWT_SECRET = "dgg7xdViY-IvFh7opP7E6d7FRa7c70IQs0r_swg0LAx_kNzzociPhl3ID0v1aT-R"
JWT_EXP_MINUTES = "1440"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"cd /home/runner/workspace && uv run uvicorn api.main:app --host 127.0.0.1 --port 8000 & cd /home/runner/workspace/frontend && npm run dev\""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd /home/runner/workspace && uv run uvicorn api.main:app --host 127.0.0.1 --port 8000 & uv run streamlit run packages/frontend/src/frontend/main.py"]
